# EditorConfig is awesome: https://EditorConfig.org

# Top-most EditorConfig file
root = true

# Default rules for all files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Java source code and XML files (Backend / Spring Boot / Maven)
[*.{java,xml}]
indent_size = 4

# TypeScript (Frontend / Angular)
[*.ts]
quote_type = single
ij_typescript_use_double_quotes = false

# Markdown files
[*.md]
max_line_length = off
trim_trailing_whitespace = false

# Makefiles and similar
[Makefile]
indent_style = tab
